---
interface Props {
  title?: string;
}
const { title = 'WeakKey Typer — Targeted Typing Practice' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Drill your weakest keyboard characters with targeted typing practice" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('typing_theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-slate-100 text-slate-800 dark:bg-base dark:text-text font-mono min-h-screen flex flex-col transition-colors duration-200">
    <main class="flex-1">
      <slot />
    </main>
    <footer class="py-4 text-center text-subtext text-xs">
      <p>WeakKey Typer &mdash; built to sharpen your typing weaknesses</p>
    </footer>
  </body>
</html>
