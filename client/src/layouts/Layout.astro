---
interface Props {
  title?: string;
}
const { title = 'WeakKey Typer — Targeted Typing Practice' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Drill your weakest keyboard characters with targeted typing practice" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-base text-text font-mono min-h-screen flex flex-col">
    <main class="flex-1">
      <slot />
    </main>
    <footer class="py-4 text-center text-subtext text-xs">
      <p>WeakKey Typer &mdash; built to sharpen your typing weaknesses</p>
    </footer>
  </body>
</html>
